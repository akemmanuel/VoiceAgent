{
  "manifest_version": 3,
  "name": "VoiceAgent",
  "version": "0.1.0",
  "description": "VoiceAgent browser extension starter.",
  "action": {
    "default_title": "Open VoiceAgent",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "storage", "offscreen", "downloads", "debugger"],
  "sandbox": { "pages": ["repl/index.html"] },
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-downloads; script-src 'self' 'unsafe-eval' blob: https: http:; worker-src blob:; connect-src * data: blob:; child-src blob:;"
  }
}
